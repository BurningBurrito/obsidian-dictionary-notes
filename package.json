{
	"name": "dictionary-notes",
	"version": "1.2.0",
	"description": "Build a dictionary in your vault: look up definitions, idioms, and quotes, and save each one as a note using your own templates.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node tests/run.mjs",
		"test:record": "node tests/run.mjs --record"
	},
	"keywords": [
		"obsidian",
		"dictionary",
		"definitions",
		"idioms",
		"quotes",
		"wiktionary",
		"wikiquote",
		"notes"
	],
	"author": "BurningBurrito",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"linkedom": "0.18.13",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
